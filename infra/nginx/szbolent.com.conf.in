# szbolent.com 门户。只按域名接入，不是 default_server。
# 本机 80 的 default_server 归 looma：IP 直连继续进宿主。
# 备案证书未落到 /etc/letsencrypt/live/szbolent.com/ 前不写 443——
# 写了 ssl_certificate 而证书不存在，会让 nginx -t 直接失败。
server {
    listen 80;
    listen [::]:80;
    server_name szbolent.com www.szbolent.com;

    client_max_body_size 20m;
    charset utf-8;

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
    gzip_min_length 256;

    location /.well-known/acme-challenge/ {
        root @CERTBOT_ROOT@;
        default_type "text/plain";
        allow all;
    }

    # /v1 只进本机 looma。浏览器仍请求 szbolent.com，不跨域。
    location /v1 {
        proxy_pass http://127.0.0.1:@LOOMA_PORT@;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 10s;
    }

    # >>> WP_UPSTREAM_BEGIN
    # 书店（WordPress）跑在 @WP_UPSTREAM@，浏览器只打本机 /wp-json 与 /wp-content。
    # bootstrap.sh 的 --wp-upstream 为空时，本段整体不渲染——
    # 否则在书店本机上会变成「自己反代自己」，nginx 起得来但请求打转。
    location /wp-json/ {
        proxy_pass http://@WP_UPSTREAM@;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 10s;
    }

    location /wp-content/ {
        proxy_pass http://@WP_UPSTREAM@;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 10s;
    }
    # <<< WP_UPSTREAM_END

    location / {
        root @PORTAL_ROOT@;
        try_files $uri $uri/ /index.html;
    }
}
