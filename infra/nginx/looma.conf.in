# 宿主只听 127.0.0.1:@LOOMA_PORT@。按 IP 进来的默认站点只放行 App 用的接口。
# 根路径是团队内部 API 看板，不向公网提供。
# 核（:@CORE_PORT@）与 gfcc（:@GFCC_PORT@）不在这里反代。
#
# @DEFAULT_FLAG@ 由 bootstrap.sh 决定：
#   - 机器上无其他 default_server → 渲染为 default_server（IP 直连进宿主）
#   - 已有其他 default_server（共存/预发场景）→ 渲染为空，不抢默认，避免 nginx -t 报
#     "duplicate default server for 0.0.0.0:80" 并连带把原站点摘掉
server {
    listen 80@DEFAULT_FLAG@;
    listen [::]:80@DEFAULT_FLAG@;
    server_name _;

    client_max_body_size 20m;

    location = /v1/endpoints {
        return 404;
    }

    location = /v1/endpoints/ {
        return 404;
    }

    location /v1/ {
        proxy_pass http://127.0.0.1:@LOOMA_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    location = /health {
        proxy_pass http://127.0.0.1:@LOOMA_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }

    location / {
        return 404;
    }
}
