# looma 宿主 .env 模板
# 由 bootstrap.sh secrets 渲染并写入 @LOOMA_DIR@/.env（600）
# 模板里的「at 符号包起来的占位标记」会在渲染时替换；正文不要出现裸 at 符号
#
# 分三类：
#   A 约定值  —— 照抄，一般不用改
#   B 机器自生成 —— 缺失时 bootstrap 现场 openssl rand，绝不出机器
#   C 外部凭据 —— 人工填，缺失只降级不阻断启动

# ---------- A 约定值 ----------
FLASK_ENV=production
DATABASE_PATH=@LOOMA_DIR@/data/looma.db
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
# 支付网关：必须与生产一致（106 线上为 false）。
# 预发机若不想触发真实下单，可临时改 true —— 但上生产前务必改回 false，
# 否则确权/支付流程会被静默跳过，问题要等到真实交易才暴露。
PAYMENT_STUB_MODE=false

# 职位库数据源开关：CN=走内置 5 条 MOCK_JOBS；非 CN=走海外源。
# 预发机若要与生产行为一致就填 CN，想验证海外分支再改成 SG/GLOBAL。
DEPLOY_REGION=CN

# 宿主 → 核的调用方式。inprocess=同进程导入（默认，省一次网络跳）；
# http=走 core_proxy 蓝图转发到下面的 URL。生产用 http 才能把核独立重启。
THOMAS_CORE_MODE=http
THOMAS_CORE_URL=http://127.0.0.1:@CORE_PORT@

# ---------- B 机器自生成（bootstrap.sh secrets 自动生成） ----------
SECRET_KEY=
JWT_SECRET=
ETHOS_AUTH_SECRET=
# 信号入账 HMAC：必须与 gfcc-kernel/.env 逐字相同（bootstrap 生成后抄给 gfcc）。
# 放在宿主生成，是因为校验方在宿主；让 gfcc 自己生成就等于两边必然不一致。
SIGNAL_INGEST_SECRET=

# ---------- C 外部凭据（人工填） ----------
DEEPSEEK_API_KEY=
QCC_ENABLED=true
QCC_AUTH_TOKEN=
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=

# 微信三项：必须与 thomas/.env 逐字相同（bootstrap 自动抄齐并哈希校验）。
# WECHAT_DEV_MODE 必须是 false，否则跳过真实 code2session，假 code 也会"登录成功"，
# 闭环探针就失去判定力。
WECHAT_APPID=
WECHAT_DEV_MODE=false
WECHAT_APP_SECRET=

# ---------- D 可选 ----------
# 浏览器跨域白名单，逗号分隔。留空=同源（门户经 nginx 反代，通常无需配）
CORS_ORIGINS=
# 日志级别：DEBUG/INFO/WARNING
LOG_LEVEL=INFO
