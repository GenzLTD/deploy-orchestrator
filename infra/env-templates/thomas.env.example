# thomas-core .env 模板
# 由 bootstrap.sh secrets 渲染并写入 @THOMAS_DIR@/.env（600）
#
# 核侧只放「与宿主同值」的密钥。端口、DATABASE_PATH、THOMAS_SCHEMA_SPLIT
# 都在 systemd 单元 / ledger.conf drop-in 里（Environment= 优先于 EnvironmentFile，
# 写在本文件里不生效）。

# ---------- 从 @LOOMA_DIR@/.env 抄齐（bootstrap 自动完成 + 哈希校验） ----------
JWT_SECRET=
SECRET_KEY=
WECHAT_APPID=
WECHAT_APP_SECRET=
WECHAT_DEV_MODE=false
DEEPSEEK_API_KEY=
ETHOS_AUTH_SECRET=
# 华为登录：核侧 thomas_core/auth/huawei_auth.py 直接读这两项，
# 只填宿主的话核拿不到，华为端登录会掉回「无配置」分支。
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=

# 说明：上述任何一项与宿主不一致，核签出的 token 宿主不认，
# 微信登录会打到另一个应用（appid 不同则 code2session 报 invalid code）。
