# thomas-core .env 模板 —— 核侧只放「与宿主同值」的密钥，其余约定值在 systemd 单元里
# 用法：bootstrap.sh secrets 自动从 ~/looma/.env 抄齐以下键（值不过手、不进聊天）
# 若五键与宿主不一致，核签出的登录态宿主不认，微信登录打到错误的应用

# --- 从 ~/looma/.env 抄齐（bootstrap.sh secrets 自动完成并哈希校验） ---
JWT_SECRET=
SECRET_KEY=
WECHAT_APPID=
WECHAT_APP_SECRET=
WECHAT_DEV_MODE=false
DEEPSEEK_API_KEY=
ETHOS_AUTH_SECRET=

# 核的端口、DATABASE_PATH、THOMAS_SCHEMA_SPLIT 都在 systemd 单元/drop-in 里，
# 不在本文件重复；改了也不生效（Environment= 优先于 EnvironmentFile）。
