# looma 宿主 .env 模板 —— 只有键名与约定值，密钥类由 bootstrap.sh 生成或人工填入
# 用法：bootstrap.sh secrets 会按本模板创建 ~/looma/.env，600 权限

# --- 约定值（直接照抄） ---
FLASK_ENV=production
DATABASE_PATH=/home/ubuntu/looma/data/looma.db
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
PAYMENT_STUB_MODE=false
DEPLOY_REGION=CN
THOMAS_CORE_MODE=http
THOMAS_CORE_URL=http://127.0.0.1:5300

# --- 机器自生成（bootstrap.sh secrets 自动 openssl rand 生成） ---
SECRET_KEY=
JWT_SECRET=
ETHOS_AUTH_SECRET=

# --- 外部凭据（人工找回，缺失只降级不阻断启动） ---
DEEPSEEK_API_KEY=
QCC_ENABLED=true
QCC_AUTH_TOKEN=
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=

# --- 微信三项（与 thomas/.env 必须逐字相同；WECHAT_DEV_MODE 必须是 false） ---
WECHAT_APPID=
WECHAT_DEV_MODE=false
WECHAT_APP_SECRET=
