# gfcc-kernel .env 模板
# 由 bootstrap.sh secrets 渲染并写入 @GFCC_DIR@/.env（600）
# 仅回环 :@GFCC_PORT@，伴生核；业务键以 GenzLTD/gfcc 仓部署文档为准

# ---------- 与 looma/thomas 同值（bootstrap 从宿主抄齐） ----------
ETHOS_AUTH_SECRET=
# 没有它 = Stub 放行模式；填了 = HMAC 严格模式，未签名调用方会被拒。
# 必须与宿主 looma/.env 同值 —— 本文件不生成，由 bootstrap 从宿主抄过来。
SIGNAL_INGEST_SECRET=
